{
  "name": "forge-framework",
  "version": "0.7.0",
  "description": "Solomon's Forge — a governance framework for AI-assisted software construction: handoff contracts, fail-closed validation gates, and attestation logging.",
  "author": "Pat Little",
  "homepage": "https://littlerevelationsstudio.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snakeward/solomons-forge.git"
  },
  "bugs": {
    "url": "https://github.com/snakeward/solomons-forge/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint:terms": "node src/lint/term-leak.js",
    "lint:spec": "node src/lint/spec-structure.js",
    "validate:handoff": "node src/validate/handoff.js",
    "receipt:acceptance": "node src/receipt/acceptance.js",
    "contract:bind": "node src/contract/bind.js",
    "test:acceptance": "node harness/acceptance/run.js",
    "build:vscode": "node extensions/vscode/scripts/build.js",
    "pretest": "npm run build:vscode",
    "test": "node --test --test-concurrency=1"
  }
}
